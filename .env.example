# Backend API base URLs (trailing slash required)
NEXT_PUBLIC_BASE_URL=http://localhost:4000/
NEXT_PUBLIC_KOA2_BASE_URL=http://localhost:8000/

# Set to "true" to point the app at the dev API (https://dev-api.exportcomments.io/)
NEXT_PUBLIC_USE_DEV_ENV=false

# Hostname used to pick the API when rendering on the server (the browser uses window.location).
# Leave as localhost for local development.
NEXT_PUBLIC_HOSTNAME=localhost
